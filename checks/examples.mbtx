----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/x@0.5.5/fs",
  "moonbitlang/core/json",
}
----

async fn main {
  let index = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/upstream/indexes.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(index.exit_code(), 1)
  let original = @json.parse(index.stdout())
  guard original is { "source": String(upstream_sql), "statements": Array(statements), "findings": Array(findings), "complete": True, .. } else { fail("Expected a complete fixture report") }
  assert_eq(statements.length(), 17)
  assert_eq(findings.length(), 17)
  @fs.write_string_to_file("_build/umami-report.json", index.stdout())
  let replay = @shell.Cmd("moon", ["run", "engine/cli", "--", "_build/umami-report.json", "--replay", "--json"]).output()
  assert_eq(replay.exit_code(), 1)
  assert_eq(@json.parse(replay.stdout()), original)
  let mixed = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/upstream/mixed.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(mixed.exit_code(), 2)
  guard @json.parse(mixed.stdout()) is { "statements": Array(statements), "complete": False, .. } else { fail("Expected incomplete mixed migration") }
  assert_eq(statements.length(), 9)
  let advanced = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/advanced.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(advanced.exit_code(), 1)
  guard @json.parse(advanced.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected assessed advanced indexes") }
  assert_eq(findings.filter(f => f is { "code": String("PG106"), .. }).length(), 2)
  assert_eq(findings.filter(f => f is { "code": String("PG107"), .. }).length(), 1)
  assert_eq(findings.filter(f => f is { "code": String("PG108"), .. }).length(), 1)
  let mut portable_report : Json? = None
  for target in ["wasm", "wasm-gc", "js"] {
    let bounded = @shell.Cmd("moon", ["run", "--target", target, "engine/cli", "--", "specimens/bounded-lock.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
    assert_eq(bounded.exit_code(), 0)
    let report = @json.parse(bounded.stdout())
    guard report is { "complete": True, "findings": Array(findings), .. } else { fail("Expected a complete bounded-lock report") }
    assert_eq(findings.filter(f => f is { "code": String("PG305"), "message": String("Effective lock_timeout is 1000ms for this index."), .. }).length(), 1)
    assert_eq(findings.filter(f => f is { "code": String("PG307"), "message": String("Effective statement_timeout is 30000ms for this index."), .. }).length(), 1)
    match portable_report {
      None => portable_report = Some(report)
      Some(previous) => assert_eq(report, previous)
    }
    @fs.write_string_to_file("_build/timeout-report.json", bounded.stdout())
    let replay = @shell.Cmd("moon", ["run", "--target", target, "engine/cli", "--", "_build/timeout-report.json", "--replay", "--json"]).output()
    assert_eq(replay.exit_code(), 0)
    assert_eq(@json.parse(replay.stdout()), report)
    let sarif = @shell.Cmd("moon", ["run", "--target", target, "engine/cli", "--", "specimens/bounded-lock.sql", "--sarif", "--transaction=autocommit", "--delivery=statements"]).output()
    assert_eq(sarif.exit_code(), 0)
    guard @json.parse(sarif.stdout()) is { "version": String("2.1.0"), "runs": Array(runs), .. } else { fail("Expected SARIF output") }
    guard runs[0] is { "properties": { "moonddlReview": retained, .. }, .. } else { fail("Missing retained review") }
    assert_eq(retained, report)
  }
  let grouped = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/bounded-lock.sql", "--json", "--transaction=autocommit", "--delivery=simple-query"]).output()
  assert_eq(grouped.exit_code(), 1)
  guard @json.parse(grouped.stdout()) is { "findings": Array(findings), .. } else { fail("Expected grouped findings") }
  assert_eq(findings.filter(f => f is { "code": String("PG201"), .. }).length(), 1)
  let scoped = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/local-timeout.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(scoped.exit_code(), 1)
  guard @json.parse(scoped.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected LOCAL scope findings") }
  assert_eq(findings.filter(f => f is { "code": String("PG305"), "message": String("Effective lock_timeout is 100ms for this index."), .. }).length(), 1)
  assert_eq(findings.filter(f => f is { "code": String("PG305"), "message": String("Effective lock_timeout is 2000ms for this index."), .. }).length(), 1)
  let replacement = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/replace-index.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(replacement.exit_code(), 0)
  guard @json.parse(replacement.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected complete replacement review") }
  assert_eq(findings.filter(f => f is { "code": String("PG110"), .. }).length(), 1)
  for delivery in ["statements", "simple-query"] {
    let phases = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/check-phases.sql", "--json", "--transaction=autocommit", "--delivery=" + delivery]).output()
    assert_eq(phases.exit_code(), 1)
    guard @json.parse(phases.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected assessed CHECK phases") }
    assert_eq(findings.filter(f => f is { "code": String("PG405"), .. }).length(), if delivery == "simple-query" { 1 } else { 0 })
  }
  for options in [["--sarif", "--json"], ["--artifact=x"], ["--sarif", "--artifact=../x"]] {
    let args = ["run", "engine/cli", "--", "specimens/ordinary.sql"]
    args.append(options)
    assert_eq(@shell.Cmd("moon", args).output().exit_code(), 2)
  }
  let sarif_replay = @shell.Cmd("moon", ["run", "engine/cli", "--", "_build/timeout-report.json", "--replay", "--sarif", "--artifact=specimens/bounded-lock.sql"]).output()
  assert_eq(sarif_replay.exit_code(), 0)
  assert_eq(@shell.Cmd("moon", ["run", "engine/cli", "--", "_build/timeout-report.json", "--replay", "--sarif"]).output().exit_code(), 2)
  let unchanged = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/upstream/indexes.sql", "--json", "--transaction=autocommit", "--delivery=statements", "--baseline=_build/umami-report.json"]).output()
  assert_eq(unchanged.exit_code(), 0)
  @fs.write_string_to_file("_build/umami-candidate.sql", upstream_sql + "\nCREATE INDEX added_idx ON website (name);")
  let candidate = @shell.Cmd("moon", ["run", "engine/cli", "--", "_build/umami-candidate.sql", "--json", "--transaction=autocommit", "--delivery=statements", "--baseline=_build/umami-report.json"]).output()
  assert_eq(candidate.exit_code(), 1)
  guard @json.parse(candidate.stdout()) is { "format": String("moonddl.delta.v1"), "introduced": Array(introduced), "resolved": Array(resolved), "unchanged": Number(count, ..), .. } else { fail("Expected a review delta") }
  assert_eq(count, 17)
  assert_eq(introduced.length(), 1)
  assert_eq(resolved.length(), 0)
  for extra in ["--sarif", "--transaction=active"] {
    assert_eq(@shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/upstream/indexes.sql", "--baseline=_build/umami-report.json", "--transaction=autocommit", "--delivery=statements", extra]).output().exit_code(), 2)
  }
  @fs.write_string_to_file("_build/incomplete-report.json", mixed.stdout())
  assert_eq(@shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/upstream/indexes.sql", "--baseline=_build/incomplete-report.json", "--transaction=autocommit", "--delivery=statements"]).output().exit_code(), 2)
  let point = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/savepoint-budget.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(point.exit_code(), 1)
  guard @json.parse(point.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected complete savepoint review") }
  assert_eq(findings.filter(f => f is { "code": String("PG305"), "message": String("Effective lock_timeout is 100ms for this index."), .. }).length(), 1)
  assert_eq(findings.filter(f => f is { "code": String("PG305"), "message": String("Effective lock_timeout is 2000ms for this index."), .. }).length(), 1)
  let attachment = @shell.Cmd("moon", ["run", "engine/cli", "--", "specimens/attach-unique.sql", "--json", "--transaction=autocommit", "--delivery=statements"]).output()
  assert_eq(attachment.exit_code(), 1)
  guard @json.parse(attachment.stdout()) is { "complete": True, "findings": Array(findings), .. } else { fail("Expected complete attachment review") }
  assert_eq(findings.filter(f => f is { "code": String("PG407"), .. }).length(), 1)
  assert_eq(findings.filter(f => f is { "code": String("PG409"), .. }).length(), 1)
  println("Migration specimens, portable reports and baseline gates passed.")
}
