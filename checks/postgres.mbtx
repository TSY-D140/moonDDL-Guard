        #|  IF to_regclass('purchases_pkey') IS NULL THEN RAISE EXCEPTION 'Constraint index not renamed'; END IF;
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='purchases'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Rename lock not retained'; END IF;
        #|END $$;
        #|ROLLBACK TO before_rename;
        #|DO $$ BEGIN
        #|  IF to_regclass('orders') IS NULL OR to_regclass('purchases') IS NOT NULL OR to_regclass('orders_pkey') IS NULL THEN RAISE EXCEPTION 'Rename rollback failed'; END IF;
        #|END $$;
      )),
      ("foreign-key scans, both lock targets and staged validation", (
        #|DO $$ BEGIN
        #|  BEGIN
        #|    ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id);
        #|    RAISE EXCEPTION 'Immediate FK unexpectedly accepted orphan rows';
        #|  EXCEPTION WHEN foreign_key_violation THEN NULL;
        #|  END;
        #|END $$;
        #|ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id) NOT VALID;
        #|DO $$ BEGIN
        #|  IF (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'NOT VALID was already validated';
        #|  END IF;
        #|  IF (SELECT count(*) FROM pg_locks WHERE pid=pg_backend_pid() AND granted
        #|      AND mode='ShareRowExclusiveLock' AND relation IN ('child'::regclass,'parent'::regclass)) <> 2 THEN
        #|    RAISE EXCEPTION 'Both FK table locks were not retained';
        #|  END IF;
        #|END $$;
        #|DELETE FROM child WHERE parent_id=999;
        #|ALTER TABLE child VALIDATE CONSTRAINT fk;
        #|DO $$ BEGIN
        #|  IF NOT (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'Validation did not update metadata';
        #|  END IF;
        #|END $$;
      )),
      ("constant/stable defaults, volatile rewrite and known integer conversion", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD COLUMN status text DEFAULT 'pending';
        #|  ALTER TABLE orders ADD COLUMN received_at timestamptz DEFAULT now();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'Constant/stable defaults unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE orders ADD COLUMN recorded_at timestamptz DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Volatile ADD did not rewrite';
        #|  END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ALTER COLUMN recorded_at SET DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'SET DEFAULT unexpectedly backfilled/rebuilt';
        #|  END IF;
        #|  ALTER TABLE orders ALTER COLUMN amount TYPE bigint USING amount::bigint;
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Known int4-to-int8 conversion did not rewrite';
        #|  END IF;
        #|END $$;
      )),
      ("column removal, constraint-owned index and dependent view removal", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders DROP COLUMN legacy;
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'DROP COLUMN unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE parent DROP CONSTRAINT parent_pkey;
        #|  IF to_regclass('parent_pkey') IS NOT NULL THEN RAISE EXCEPTION 'Owned index survived'; END IF;
        #|  DROP TABLE history CASCADE;
        #|  IF to_regclass('history_view') IS NOT NULL THEN RAISE EXCEPTION 'Dependent view survived'; END IF;
        #|END $$;
      )),
      ("dependent types sequences routines triggers and RLS retirement", (
        #|CREATE TYPE retired_state AS ENUM('old');
        #|CREATE TABLE typed_rows(id int, status retired_state);
        #|INSERT INTO typed_rows VALUES(1,'old');
        #|DROP TYPE retired_state CASCADE;
        #|DO $$ BEGIN
        #|  IF EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='typed_rows'::regclass AND attname='status' AND NOT attisdropped) THEN RAISE EXCEPTION 'Dependent type column survived'; END IF;
        #|END $$;
        #|CREATE SEQUENCE retired_seq;
        #|CREATE TABLE sequence_rows(id int DEFAULT nextval('retired_seq'));
        #|DROP SEQUENCE retired_seq CASCADE;
        #|DO $$ BEGIN
        #|  IF EXISTS(SELECT 1 FROM pg_attrdef WHERE adrelid='sequence_rows'::regclass) THEN RAISE EXCEPTION 'Dependent default survived'; END IF;
        #|END $$;
        #|CREATE FUNCTION retired_format(integer) RETURNS integer LANGUAGE SQL IMMUTABLE AS $fn$ SELECT $1 $fn$;
        #|CREATE FUNCTION retired_format(text) RETURNS text LANGUAGE SQL IMMUTABLE AS $fn$ SELECT $1 $fn$;
        #|DROP FUNCTION retired_format(integer);
        #|DO $$ BEGIN
        #|  IF to_regprocedure('retired_format(integer)') IS NOT NULL OR to_regprocedure('retired_format(text)') IS NULL THEN RAISE EXCEPTION 'Wrong overload removed'; END IF;
        #|END $$;
        #|SET LOCAL ROLE pg_read_all_data;
        #|DO $$ BEGIN IF (SELECT count(*) FROM policy_rows)<>1 THEN RAISE EXCEPTION 'Policy did not permit read'; END IF; END $$;
        #|RESET ROLE;
        #|DROP POLICY visible ON policy_rows CASCADE;
        #|DO $$ BEGIN
        #|  IF NOT EXISTS(SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='policy_rows'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Policy table lock missing'; END IF;
        #|  IF NOT (SELECT relrowsecurity FROM pg_class WHERE oid='policy_rows'::regclass) THEN RAISE EXCEPTION 'Dropping policy disabled RLS'; END IF;
        #|END $$;
        #|SET LOCAL ROLE pg_read_all_data;
        #|DO $$ BEGIN IF (SELECT count(*) FROM policy_rows)<>0 THEN RAISE EXCEPTION 'Default deny did not apply'; END IF; END $$;
        #|RESET ROLE;
        #|DROP TRIGGER legacy_audit ON orders;
        #|DO $$ BEGIN
        #|  IF EXISTS(SELECT 1 FROM pg_trigger WHERE tgrelid='orders'::regclass AND tgname='legacy_audit') THEN RAISE EXCEPTION 'Trigger survived'; END IF;
        #|  IF NOT EXISTS(SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='orders'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Trigger table lock missing'; END IF;
        #|END $$;
      )),
      ("existing enum transaction visibility and textual rename", (
        #|ALTER TYPE delivery_status ADD VALUE 'queued' BEFORE 'paid';
        #|DO $$ BEGIN
        #|  BEGIN
        #|    PERFORM 'queued'::delivery_status;
        #|    RAISE EXCEPTION 'Uncommitted existing-type enum value was usable';
        #|  EXCEPTION WHEN unsafe_new_enum_value_usage THEN NULL;
        #|  END;
        #|END $$;
        #|ALTER TYPE delivery_status RENAME VALUE 'pending' TO 'awaiting_payment';
        #|DO $$ BEGIN
        #|  IF ('awaiting_payment'::delivery_status)::text <> 'awaiting_payment' THEN RAISE EXCEPTION 'Label rename failed'; END IF;
        #|  IF NOT EXISTS (SELECT 1 FROM pg_enum e JOIN pg_type t ON t.oid=e.enumtypid JOIN pg_namespace n ON n.oid=t.typnamespace WHERE n.nspname='moonddl_guard_probe' AND t.typname='delivery_status' AND e.enumlabel='queued' AND e.enumsortorder>1 AND e.enumsortorder<2) THEN RAISE EXCEPTION 'BEFORE ordering failed'; END IF;
        #|END $$;
      )),
      ("bootstrap FK lock and repeatable seed conflict semantics", (
        #|CREATE TABLE seeded(id int PRIMARY KEY, label text NOT NULL DEFAULT 'pending', parent_id int REFERENCES parent(id));
        #|DO $$ BEGIN
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='parent'::regclass AND mode='ShareRowExclusiveLock' AND granted) THEN
        #|    RAISE EXCEPTION 'New FK did not lock referenced parent';
        #|  END IF;
        #|END $$;
        #|INSERT INTO seeded(id,label) VALUES(1,'pending'),(2,'paid') ON CONFLICT(id) DO NOTHING;
        #|INSERT INTO seeded(id,label) VALUES(2,'ignored') ON CONFLICT(id) DO NOTHING;
        #|DO $$ BEGIN
        #|  IF (SELECT label FROM seeded WHERE id=2) <> 'paid' THEN RAISE EXCEPTION 'DO NOTHING replaced existing data'; END IF;
        #|END $$;
        #|INSERT INTO seeded(id,label) VALUES(2,'settled') ON CONFLICT(id) DO UPDATE SET label=excluded.label;
        #|DO $$ BEGIN
        #|  IF (SELECT label FROM seeded WHERE id=2) <> 'settled' THEN RAISE EXCEPTION 'Upsert did not update'; END IF;
        #|  BEGIN
        #|    INSERT INTO seeded(id) VALUES(1),(1) ON CONFLICT(id) DO UPDATE SET label='duplicate';
        #|    RAISE EXCEPTION 'Repeated conflict unexpectedly succeeded';
        #|  EXCEPTION WHEN cardinality_violation THEN NULL;
        #|  END;
        #|END $$;
      )),
      ("TRUNCATE and owned sequence recovery through savepoint rollback", (
        #|SAVEPOINT before_truncate;
        #|TRUNCATE events RESTART IDENTITY;
        #|DO $$ DECLARE new_id integer; BEGIN
        #|  IF (SELECT count(*) FROM events) <> 0 THEN RAISE EXCEPTION 'Rows survived'; END IF;
        #|  INSERT INTO events DEFAULT VALUES RETURNING id INTO new_id;
        #|  IF new_id <> 1 THEN RAISE EXCEPTION 'Identity did not restart'; END IF;
        #|END $$;
        #|ROLLBACK TO before_truncate;
        #|DO $$ BEGIN
        #|  IF (SELECT count(*) FROM events) <> 2 THEN RAISE EXCEPTION 'Rows not restored'; END IF;
        #|  IF nextval('events_id_seq') <> 3 THEN RAISE EXCEPTION 'Sequence not restored'; END IF;
        #|END $$;
      )),
    ] {
      println("Checking " + name)
      sql("BEGIN; SET LOCAL search_path=moonddl_guard_probe,pg_catalog; SET LOCAL lock_timeout='2s'; SET LOCAL statement_timeout='20s'; " + body + " ROLLBACK;")
    }
    println("Checking two-session contention timeout and recovery")
    sql("CREATE TABLE moonddl_guard_probe.contention_release(released bool);")
    @async.with_task_group(async fn(group) {
      let holder = group.spawn(async fn() {
        // An explicit release signal keeps the lock until the contender has
        // failed; a fixed sleep could expire first on a slow CI runner.
        sql("BEGIN; SET application_name='moonddl_guard_holder'; SET statement_timeout='20s'; ALTER TABLE moonddl_guard_probe.orders ADD holder_a int, ADD holder_b int; DO $$ BEGIN FOR i IN 1..300 LOOP IF EXISTS(SELECT 1 FROM moonddl_guard_probe.contention_release) THEN RETURN; END IF; PERFORM pg_sleep(0.05); END LOOP; RAISE EXCEPTION 'Contender did not release holder'; END $$; COMMIT;")
      })
      let mut ready = false
      for _ in 0..<60 {
        let probe = @shell.Cmd("psql", ["-XAt", "-c", "SELECT count(*) FROM pg_locks l JOIN pg_stat_activity a USING(pid) WHERE a.application_name='moonddl_guard_holder' AND l.relation='moonddl_guard_probe.orders'::regclass AND l.mode='AccessExclusiveLock' AND l.granted"]).output(timeout_ms=5000)
        if probe.exit_code() == 0 && probe.stdout().trim() == "1" { ready = true; break }
        @async.sleep(50)
      }
      assert_true(ready, msg="Holder never acquired lock")
      let blocked = @shell.Cmd("psql", ["-X", "-v", "ON_ERROR_STOP=1", "-c", "SET lock_timeout='200ms'; UPDATE moonddl_guard_probe.orders SET amount=amount WHERE id=1;"]).output(timeout_ms=5000)
      assert_true(blocked.exit_code() != 0 && blocked.stderr().contains("lock timeout"), msg=blocked.stderr())
      sql("INSERT INTO moonddl_guard_probe.contention_release VALUES(true);")
      holder.wait()
      sql("SET lock_timeout='2s'; UPDATE moonddl_guard_probe.orders SET amount=amount WHERE id=1;")
    })
    println("Checking enum value use after separate committed extension")
    sql("ALTER TYPE moonddl_guard_probe.delivery_status ADD VALUE 'settled';")
    sql("DO $$ BEGIN PERFORM 'settled'::moonddl_guard_probe.delivery_status; END $$;")
    None
  } catch { error => Some("\{Repr(error)}") }
  // Setup succeeded, so this schema belongs to this run. Failed case connections
  // close/rollback before cleanup; pre-existing schemas never reach this branch.
  sql("DROP SCHEMA moonddl_guard_probe CASCADE;")
  if failure is Some(message) { fail(message) }
  println("PostgreSQL 18 semantic checks passed.")
}
