----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/fs",
}
----

async fn sql(command : String) -> Unit {
  let result = @shell.Cmd("psql", ["--no-psqlrc", "--set", "ON_ERROR_STOP=1", "--no-align", "--tuples-only", "--command", command]).output(timeout_ms=30000)
  if result.exit_code() != 0 { fail("PostgreSQL verification failed: " + result.stderr()) }
  println(result.stdout())
}

async fn main {
  let args = @env.args()
  if args.length() == 2 && args[1] == "--check-only" {
    println("PostgreSQL script compiled; no server checks executed.")
    return
  }
  if @env.get_env_var("PGDATABASE") != Some("moonddl_guard_test") {
    fail("Set PGDATABASE=moonddl_guard_test for an isolated PostgreSQL 18 test database; existing moonddl_guard_probe schemas are refused.")
  }
  // One implicit transaction: a setup failure rolls back, never deletes an old schema.
  let setup =
    #|DO $$ BEGIN
    #|  IF current_setting('server_version_num')::int / 10000 <> 18 THEN
    #|    RAISE EXCEPTION 'PostgreSQL 18 required';
    #|  END IF;
    #|END $$;
    #|CREATE SCHEMA moonddl_guard_probe;
    #|SET search_path=moonddl_guard_probe,pg_catalog;
    #|CREATE TABLE parent(id integer PRIMARY KEY);
    #|CREATE TABLE child(id integer PRIMARY KEY, parent_id integer);
    #|CREATE TABLE orders(id integer PRIMARY KEY, amount integer, legacy text);
    #|CREATE TABLE history(id integer);
    #|CREATE VIEW history_view AS SELECT id FROM history;
    #|CREATE TABLE events(id integer GENERATED BY DEFAULT AS IDENTITY);
    #|CREATE TABLE website_event(id integer PRIMARY KEY, website_id integer, session_id integer, created_at timestamptz);
    #|CREATE TABLE "session"(session_id integer, website_id integer, hostname varchar(100), subdivision1 text, subdivision2 text, created_at timestamptz);
    #|INSERT INTO website_event VALUES (1,1,10,now()),(2,1,20,now());
    #|INSERT INTO "session" VALUES (10,1,'a.example','west','old',now()),(20,1,'b.example','north','old',now());
    #|INSERT INTO parent VALUES (1);
    #|INSERT INTO child VALUES (1,1),(2,999);
    #|INSERT INTO orders VALUES (1,10,'old'),(2,20,'old');
    #|INSERT INTO events DEFAULT VALUES;
    #|INSERT INTO events DEFAULT VALUES;
  let real_migration = @fs.read_file_to_string("specimens/upstream/mixed.sql")
  sql(setup)
  let failure = try {
    for (name, body) in [
      ("complete real Umami schema/data/rename/removal workflow", real_migration + (
        #|DO $$ BEGIN
        #|  IF (SELECT hostname FROM website_event WHERE id=1) <> 'a.example' OR (SELECT hostname FROM website_event WHERE id=2) <> 'b.example' THEN RAISE EXCEPTION 'Real UPDATE FROM failed'; END IF;
        #|  IF (SELECT region FROM "session" WHERE session_id=10) <> 'west' THEN RAISE EXCEPTION 'Real RENAME lost column data'; END IF;
        #|  IF EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='session'::regclass AND attname IN ('hostname','subdivision2') AND NOT attisdropped) THEN RAISE EXCEPTION 'Real DROP COLUMN failed'; END IF;
        #|END $$;
      )),
      ("bounded CTE update, retained DDL lock and DELETE USING", (
        #|ALTER TABLE orders ADD COLUMN marker integer;
        #|WITH batch AS (SELECT id FROM orders WHERE amount>=10 ORDER BY id LIMIT 1 FOR UPDATE SKIP LOCKED)
        #|UPDATE orders o SET marker=1 FROM batch b WHERE o.id=b.id;
        #|DO $$ BEGIN
        #|  IF (SELECT count(*) FROM orders WHERE marker=1) <> 1 THEN RAISE EXCEPTION 'CTE batch affected wrong rows'; END IF;
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='orders'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Strong DDL lock not retained during backfill'; END IF;
        #|END $$;
        #|DELETE FROM orders o USING child c WHERE o.id=c.id AND c.parent_id=999;
        #|DO $$ BEGIN
        #|  IF (SELECT count(*) FROM orders) <> 1 OR NOT EXISTS (SELECT 1 FROM orders WHERE id=1) THEN RAISE EXCEPTION 'DELETE USING affected wrong rows'; END IF;
        #|END $$;
      )),
      ("identity stored virtual generation and expression removal", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD COLUMN sequence_id bigint GENERATED ALWAYS AS IDENTITY;
        #|  IF pg_relation_filenode('orders'::regclass)=original OR (SELECT count(*) FROM orders WHERE sequence_id IS NOT NULL)<>2 THEN RAISE EXCEPTION 'New identity did not rewrite/assign'; END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN doubled int GENERATED ALWAYS AS (amount*2) STORED;
        #|  IF pg_relation_filenode('orders'::regclass)=original OR (SELECT doubled FROM orders WHERE id=1)<>20 THEN RAISE EXCEPTION 'Stored generation failed'; END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN virtual_doubled int GENERATED ALWAYS AS (amount*2) VIRTUAL;
        #|  IF pg_relation_filenode('orders'::regclass)<>original OR (SELECT virtual_doubled FROM orders WHERE id=1)<>20 THEN RAISE EXCEPTION 'Virtual generation unexpectedly rewrote/lost value'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN doubled SET EXPRESSION AS (amount*3);
        #|  IF (SELECT doubled FROM orders WHERE id=1)<>30 THEN RAISE EXCEPTION 'Expression replacement failed'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN doubled DROP EXPRESSION;
        #|  UPDATE orders SET amount=11 WHERE id=1;
        #|  IF (SELECT doubled FROM orders WHERE id=1)<>30 OR (SELECT virtual_doubled FROM orders WHERE id=1)<>22 THEN RAISE EXCEPTION 'Expression removal did not preserve base value'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN sequence_id SET GENERATED BY DEFAULT;
        #|  ALTER TABLE orders ALTER COLUMN sequence_id DROP IDENTITY;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN legacy_sequence bigserial;
        #|  IF pg_relation_filenode('orders'::regclass)=original OR pg_get_serial_sequence('orders','legacy_sequence') IS NULL THEN RAISE EXCEPTION 'Serial rewrite/ownership missing'; END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN external_id uuid DEFAULT gen_random_uuid();
        #|  IF pg_relation_filenode('orders'::regclass)=original THEN RAISE EXCEPTION 'UUID default did not rewrite'; END IF;
        #|END $$;
      )),
      ("direct uniqueness null semantics and primary-key requirements", (
        #|DO $$ BEGIN
        #|  BEGIN
        #|    ALTER TABLE orders ADD CONSTRAINT legacy_unique UNIQUE (legacy);
        #|    RAISE EXCEPTION 'Duplicate key incorrectly accepted';
        #|  EXCEPTION WHEN unique_violation THEN NULL; END;
        #|END $$;
        #|ALTER TABLE orders ADD CONSTRAINT amount_unique UNIQUE(amount);
        #|DO $$ BEGIN
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='orders'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Unique build lock missing'; END IF;
        #|END $$;
        #|INSERT INTO history VALUES (NULL),(NULL),(1);
        #|ALTER TABLE history ADD CONSTRAINT nullable_unique UNIQUE(id);
        #|DO $$ BEGIN
        #|  BEGIN ALTER TABLE history ADD CONSTRAINT nulls_equal UNIQUE NULLS NOT DISTINCT(id); RAISE EXCEPTION 'Duplicate nulls accepted'; EXCEPTION WHEN unique_violation THEN NULL; END;
        #|  BEGIN ALTER TABLE history ADD PRIMARY KEY(id); RAISE EXCEPTION 'Null primary key accepted'; EXCEPTION WHEN not_null_violation THEN NULL; END;
        #|END $$;
        #|DELETE FROM history WHERE id IS NULL;
        #|ALTER TABLE history ADD PRIMARY KEY(id);
      )),
      ("rename identity, retained lock and savepoint restoration", (
        #|SAVEPOINT before_rename;
        #|ALTER TABLE orders RENAME COLUMN legacy TO external_reference;
        #|ALTER TABLE orders RENAME CONSTRAINT orders_pkey TO purchases_pkey;
        #|ALTER TABLE orders RENAME TO purchases;
        #|DO $$ BEGIN
        #|  IF to_regclass('orders') IS NOT NULL OR to_regclass('purchases') IS NULL THEN RAISE EXCEPTION 'Table identity not renamed'; END IF;
        #|  IF NOT EXISTS (SELECT 1 FROM pg_attribute WHERE attrelid='purchases'::regclass AND attname='external_reference' AND NOT attisdropped) THEN RAISE EXCEPTION 'Column not renamed'; END IF;
        #|  IF to_regclass('purchases_pkey') IS NULL THEN RAISE EXCEPTION 'Constraint index not renamed'; END IF;
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='purchases'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Rename lock not retained'; END IF;
        #|END $$;
        #|ROLLBACK TO before_rename;
        #|DO $$ BEGIN
        #|  IF to_regclass('orders') IS NULL OR to_regclass('purchases') IS NOT NULL OR to_regclass('orders_pkey') IS NULL THEN RAISE EXCEPTION 'Rename rollback failed'; END IF;
        #|END $$;
      )),
      ("foreign-key scans, both lock targets and staged validation", (
        #|DO $$ BEGIN
        #|  BEGIN
        #|    ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id);
        #|    RAISE EXCEPTION 'Immediate FK unexpectedly accepted orphan rows';
        #|  EXCEPTION WHEN foreign_key_violation THEN NULL;
        #|  END;
        #|END $$;
        #|ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id) NOT VALID;
        #|DO $$ BEGIN
        #|  IF (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'NOT VALID was already validated';
        #|  END IF;
        #|  IF (SELECT count(*) FROM pg_locks WHERE pid=pg_backend_pid() AND granted
        #|      AND mode='ShareRowExclusiveLock' AND relation IN ('child'::regclass,'parent'::regclass)) <> 2 THEN
        #|    RAISE EXCEPTION 'Both FK table locks were not retained';
        #|  END IF;
        #|END $$;
        #|DELETE FROM child WHERE parent_id=999;
        #|ALTER TABLE child VALIDATE CONSTRAINT fk;
        #|DO $$ BEGIN
        #|  IF NOT (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'Validation did not update metadata';
        #|  END IF;
        #|END $$;
      )),
      ("constant/stable defaults, volatile rewrite and known integer conversion", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD COLUMN status text DEFAULT 'pending';
        #|  ALTER TABLE orders ADD COLUMN received_at timestamptz DEFAULT now();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'Constant/stable defaults unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE orders ADD COLUMN recorded_at timestamptz DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Volatile ADD did not rewrite';
        #|  END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ALTER COLUMN recorded_at SET DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'SET DEFAULT unexpectedly backfilled/rebuilt';
        #|  END IF;
        #|  ALTER TABLE orders ALTER COLUMN amount TYPE bigint USING amount::bigint;
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Known int4-to-int8 conversion did not rewrite';
        #|  END IF;
        #|END $$;
      )),
      ("column removal, constraint-owned index and dependent view removal", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders DROP COLUMN legacy;
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'DROP COLUMN unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE parent DROP CONSTRAINT parent_pkey;
        #|  IF to_regclass('parent_pkey') IS NOT NULL THEN RAISE EXCEPTION 'Owned index survived'; END IF;
        #|  DROP TABLE history CASCADE;
        #|  IF to_regclass('history_view') IS NOT NULL THEN RAISE EXCEPTION 'Dependent view survived'; END IF;
        #|END $$;
      )),
      ("bootstrap FK lock and repeatable seed conflict semantics", (
        #|CREATE TABLE seeded(id int PRIMARY KEY, label text NOT NULL DEFAULT 'pending', parent_id int REFERENCES parent(id));
        #|DO $$ BEGIN
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='parent'::regclass AND mode='ShareRowExclusiveLock' AND granted) THEN
        #|    RAISE EXCEPTION 'New FK did not lock referenced parent';
        #|  END IF;
        #|END $$;
        #|INSERT INTO seeded(id,label) VALUES(1,'pending'),(2,'paid') ON CONFLICT(id) DO NOTHING;
        #|INSERT INTO seeded(id,label) VALUES(2,'ignored') ON CONFLICT(id) DO NOTHING;
        #|DO $$ BEGIN
        #|  IF (SELECT label FROM seeded WHERE id=2) <> 'paid' THEN RAISE EXCEPTION 'DO NOTHING replaced existing data'; END IF;
        #|END $$;
        #|INSERT INTO seeded(id,label) VALUES(2,'settled') ON CONFLICT(id) DO UPDATE SET label=excluded.label;
        #|DO $$ BEGIN
        #|  IF (SELECT label FROM seeded WHERE id=2) <> 'settled' THEN RAISE EXCEPTION 'Upsert did not update'; END IF;
        #|  BEGIN
        #|    INSERT INTO seeded(id) VALUES(1),(1) ON CONFLICT(id) DO UPDATE SET label='duplicate';
        #|    RAISE EXCEPTION 'Repeated conflict unexpectedly succeeded';
        #|  EXCEPTION WHEN cardinality_violation THEN NULL;
        #|  END;
        #|END $$;
      )),
      ("TRUNCATE and owned sequence recovery through savepoint rollback", (
        #|SAVEPOINT before_truncate;
        #|TRUNCATE events RESTART IDENTITY;
        #|DO $$ DECLARE new_id integer; BEGIN
        #|  IF (SELECT count(*) FROM events) <> 0 THEN RAISE EXCEPTION 'Rows survived'; END IF;
        #|  INSERT INTO events DEFAULT VALUES RETURNING id INTO new_id;
        #|  IF new_id <> 1 THEN RAISE EXCEPTION 'Identity did not restart'; END IF;
        #|END $$;
        #|ROLLBACK TO before_truncate;
        #|DO $$ BEGIN
        #|  IF (SELECT count(*) FROM events) <> 2 THEN RAISE EXCEPTION 'Rows not restored'; END IF;
        #|  IF nextval('events_id_seq') <> 3 THEN RAISE EXCEPTION 'Sequence not restored'; END IF;
        #|END $$;
      )),
    ] {
      println("Checking " + name)
      sql("BEGIN; SET LOCAL search_path=moonddl_guard_probe,pg_catalog; SET LOCAL lock_timeout='2s'; SET LOCAL statement_timeout='20s'; " + body + " ROLLBACK;")
    }
    None
  } catch { error => Some("\{Repr(error)}") }
  // Setup succeeded, so this schema belongs to this run. Failed case connections
  // close/rollback before cleanup; pre-existing schemas never reach this branch.
  sql("DROP SCHEMA moonddl_guard_probe CASCADE;")
  if failure is Some(message) { fail(message) }
  println("PostgreSQL 18 semantic checks passed.")
}
