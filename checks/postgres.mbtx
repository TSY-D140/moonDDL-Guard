----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.5/fs",
}
----

async fn sql(command : String) -> Unit {
  let result = @shell.Cmd("psql", ["--no-psqlrc", "--set", "ON_ERROR_STOP=1", "--no-align", "--tuples-only", "--command", command]).output(timeout_ms=30000)
  if result.exit_code() != 0 { fail("PostgreSQL verification failed: " + result.stderr()) }
  println(result.stdout())
}

async fn main {
  let args = @env.args()
  if args.length() == 2 && args[1] == "--check-only" {
    println("PostgreSQL script compiled; no server checks executed.")
    return
  }
  if @env.get_env_var("PGDATABASE") != Some("moonddl_guard_test") {
    fail("Set PGDATABASE=moonddl_guard_test for an isolated PostgreSQL 18 test database; existing moonddl_guard_probe schemas are refused.")
  }
  // One implicit transaction: a setup failure rolls back, never deletes an old schema.
  let setup =
    #|DO $$ BEGIN
    #|  IF current_setting('server_version_num')::int / 10000 <> 18 THEN
    #|    RAISE EXCEPTION 'PostgreSQL 18 required';
    #|  END IF;
    #|END $$;
    #|CREATE SCHEMA moonddl_guard_probe;
    #|SET search_path=moonddl_guard_probe,pg_catalog;
    #|CREATE TABLE parent(id integer PRIMARY KEY);
    #|CREATE TYPE delivery_status AS ENUM ('pending','paid');
    #|CREATE TABLE child(id integer PRIMARY KEY, parent_id integer);
    #|CREATE TABLE orders(id integer PRIMARY KEY, amount integer, legacy text);
    #|CREATE FUNCTION audit_row() RETURNS trigger LANGUAGE plpgsql AS $fn$ BEGIN RETURN NEW; END $fn$;
    #|CREATE TRIGGER legacy_audit BEFORE INSERT ON orders FOR EACH ROW EXECUTE FUNCTION audit_row();
    #|CREATE TABLE policy_rows(id int);
    #|INSERT INTO policy_rows VALUES(1);
    #|ALTER TABLE policy_rows ENABLE ROW LEVEL SECURITY;
    #|CREATE POLICY visible ON policy_rows USING(true);
    #|CREATE TABLE history(id integer);
    #|CREATE VIEW history_view AS SELECT id FROM history;
    #|CREATE TABLE events(id integer GENERATED BY DEFAULT AS IDENTITY);
    #|CREATE TABLE website_event(id integer PRIMARY KEY, website_id integer, session_id integer, created_at timestamptz);
    #|CREATE TABLE "session"(session_id integer, website_id integer, hostname varchar(100), subdivision1 text, subdivision2 text, created_at timestamptz);
    #|INSERT INTO website_event VALUES (1,1,10,now()),(2,1,20,now());
    #|INSERT INTO "session" VALUES (10,1,'a.example','west','old',now()),(20,1,'b.example','north','old',now());
    #|INSERT INTO parent VALUES (1);
    #|INSERT INTO child VALUES (1,1),(2,999);
    #|INSERT INTO orders VALUES (1,10,'old'),(2,20,'old');
    #|INSERT INTO events DEFAULT VALUES;
    #|INSERT INTO events DEFAULT VALUES;
  let real_migration = @fs.read_file_to_string("specimens/upstream/mixed.sql")
  let real_combined = @fs.read_file_to_string("specimens/corpus/umami/1.sql") + "\n" +
    @fs.read_file_to_string("specimens/corpus/umami/2.sql") + "\n" +
    @fs.read_file_to_string("specimens/corpus/umami/5.sql") + "\n" +
    @fs.read_file_to_string("specimens/corpus/calcom/6.sql")
  sql(setup)
  let failure = try {
    for (name, body) in [
      ("four exact upstream combined-add migrations on matching disposable tables", (
        #|CREATE TABLE team(id int);
        #|CREATE TABLE "user"(id int);
        #|CREATE TABLE website(id int, user_id uuid);
        #|CREATE TABLE team_website(id int);
        #|CREATE TABLE "OrganizationOnboarding"(id int);
        #|INSERT INTO website VALUES(1,'00000000-0000-0000-0000-000000000001');
        #|INSERT INTO "OrganizationOnboarding" VALUES(1);
        #|CREATE TEMP TABLE combined_before ON COMMIT DROP AS SELECT pg_relation_filenode('website_event'::regclass) AS node;
      ) + "\n" + real_combined + (
        #|DO $$ BEGIN
        #|  IF pg_relation_filenode('website_event'::regclass) <> (SELECT node FROM combined_before) THEN RAISE EXCEPTION 'Nullable combined adds rewrote upstream table'; END IF;
        #|  IF NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='website_event'::regclass AND attname='utm_term' AND NOT attisdropped) OR NOT EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='website_event'::regclass AND attname='cls' AND NOT attisdropped) THEN RAISE EXCEPTION 'Upstream column additions missing'; END IF;
        #|  IF NOT EXISTS(SELECT 1 FROM website WHERE created_by=user_id AND team_id IS NULL) OR to_regclass('team_website') IS NOT NULL THEN RAISE EXCEPTION 'Real team redesign data/drop effects failed'; END IF;
        #|  IF NOT EXISTS(SELECT 1 FROM "OrganizationOnboarding" WHERE "bannerUrl" IS NULL AND "brandColor" IS NULL) THEN RAISE EXCEPTION 'Real onboarding additions failed'; END IF;
        #|  IF NOT EXISTS(SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='website_event'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Upstream combined-add lock not retained'; END IF;
        #|END $$;
      )),
      ("combined default rewrite skip and atomic failure semantics", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD fast int DEFAULT 7, ADD label text DEFAULT 'a,b';
        #|  IF pg_relation_filenode('orders'::regclass) <> original OR (SELECT count(*) FROM orders WHERE fast=7 AND label='a,b') <> 2 THEN RAISE EXCEPTION 'Fast combined defaults changed rewrite/value semantics'; END IF;
        #|END $$;
        #|SAVEPOINT before_volatile;
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD stamped timestamptz DEFAULT clock_timestamp(), ADD required int DEFAULT 9 NOT NULL;
        #|  IF pg_relation_filenode('orders'::regclass) = original OR (SELECT count(*) FROM orders WHERE stamped IS NOT NULL AND required=9) <> 2 THEN RAISE EXCEPTION 'Volatile combined rewrite/old-row values failed'; END IF;
        #|  IF (SELECT count(*) FROM pg_locks WHERE pid=pg_backend_pid() AND relation='orders'::regclass AND mode='AccessExclusiveLock' AND granted) <> 1 THEN RAISE EXCEPTION 'Expected one granted relation lock entry'; END IF;
        #|END $$;
        #|ROLLBACK TO before_volatile;
        #|ALTER TABLE orders ADD IF NOT EXISTS fast text DEFAULT 'ignored', ADD fresh int DEFAULT 3;
        #|DO $$ BEGIN
        #|  IF EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='orders'::regclass AND attname='required' AND NOT attisdropped) OR (SELECT count(*) FROM orders WHERE fast=7 AND fresh=3) <> 2 THEN RAISE EXCEPTION 'Rollback or IF NOT EXISTS skip changed existing values'; END IF;
        #|  BEGIN
        #|    ALTER TABLE orders ADD rolled_back int, ADD cannot_be_null int NOT NULL;
