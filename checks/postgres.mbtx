----
import {
  "moonbitlang/async@0.22.5",
  "moonbitlang/async@0.22.5/shell",
  "moonbitlang/core/env",
}
----

async fn sql(command : String) -> Unit {
  let result = @shell.Cmd("psql", ["--no-psqlrc", "--set", "ON_ERROR_STOP=1", "--no-align", "--tuples-only", "--command", command]).output(timeout_ms=30000)
  if result.exit_code() != 0 { fail("PostgreSQL verification failed: " + result.stderr()) }
  println(result.stdout())
}

async fn main {
  let args = @env.args()
  if args.length() == 2 && args[1] == "--check-only" {
    println("PostgreSQL script compiled; no server checks executed.")
    return
  }
  if @env.get_env_var("PGDATABASE") != Some("moonddl_guard_test") {
    fail("Set PGDATABASE=moonddl_guard_test for an isolated PostgreSQL 18 test database; existing moonddl_guard_probe schemas are refused.")
  }
  // One implicit transaction: a setup failure rolls back, never deletes an old schema.
  let setup =
    #|DO $$ BEGIN
    #|  IF current_setting('server_version_num')::int / 10000 <> 18 THEN
    #|    RAISE EXCEPTION 'PostgreSQL 18 required';
    #|  END IF;
    #|END $$;
    #|CREATE SCHEMA moonddl_guard_probe;
    #|SET search_path=moonddl_guard_probe,pg_catalog;
    #|CREATE TABLE parent(id integer PRIMARY KEY);
    #|CREATE TABLE child(id integer PRIMARY KEY, parent_id integer);
    #|CREATE TABLE orders(id integer PRIMARY KEY, amount integer, legacy text);
    #|CREATE TABLE history(id integer);
    #|CREATE VIEW history_view AS SELECT id FROM history;
    #|CREATE TABLE events(id integer GENERATED BY DEFAULT AS IDENTITY);
    #|INSERT INTO parent VALUES (1);
    #|INSERT INTO child VALUES (1,1),(2,999);
    #|INSERT INTO orders VALUES (1,10,'old'),(2,20,'old');
    #|INSERT INTO events DEFAULT VALUES;
    #|INSERT INTO events DEFAULT VALUES;
  sql(setup)
  let failure = try {
    for (name, body) in [
      ("foreign-key scans, both lock targets and staged validation", (
        #|DO $$ BEGIN
        #|  BEGIN
        #|    ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id);
        #|    RAISE EXCEPTION 'Immediate FK unexpectedly accepted orphan rows';
        #|  EXCEPTION WHEN foreign_key_violation THEN NULL;
        #|  END;
        #|END $$;
        #|ALTER TABLE child ADD CONSTRAINT fk FOREIGN KEY(parent_id) REFERENCES parent(id) NOT VALID;
        #|DO $$ BEGIN
        #|  IF (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'NOT VALID was already validated';
        #|  END IF;
        #|  IF (SELECT count(*) FROM pg_locks WHERE pid=pg_backend_pid() AND granted
        #|      AND mode='ShareRowExclusiveLock' AND relation IN ('child'::regclass,'parent'::regclass)) <> 2 THEN
        #|    RAISE EXCEPTION 'Both FK table locks were not retained';
        #|  END IF;
        #|END $$;
        #|DELETE FROM child WHERE parent_id=999;
        #|ALTER TABLE child VALIDATE CONSTRAINT fk;
        #|DO $$ BEGIN
        #|  IF NOT (SELECT convalidated FROM pg_constraint WHERE conrelid='child'::regclass AND conname='fk') THEN
        #|    RAISE EXCEPTION 'Validation did not update metadata';
        #|  END IF;
        #|END $$;
      )),
      ("constant/stable defaults, volatile rewrite and known integer conversion", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders ADD COLUMN status text DEFAULT 'pending';
        #|  ALTER TABLE orders ADD COLUMN received_at timestamptz DEFAULT now();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'Constant/stable defaults unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE orders ADD COLUMN recorded_at timestamptz DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Volatile ADD did not rewrite';
        #|  END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ALTER COLUMN recorded_at SET DEFAULT clock_timestamp();
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'SET DEFAULT unexpectedly backfilled/rebuilt';
        #|  END IF;
        #|  ALTER TABLE orders ALTER COLUMN amount TYPE bigint USING amount::bigint;
        #|  IF pg_relation_filenode('orders'::regclass) = original THEN
        #|    RAISE EXCEPTION 'Known int4-to-int8 conversion did not rewrite';
        #|  END IF;
        #|END $$;
      )),
      ("column removal, constraint-owned index and dependent view removal", (
        #|DO $$ DECLARE original oid := pg_relation_filenode('orders'::regclass); BEGIN
        #|  ALTER TABLE orders DROP COLUMN legacy;
        #|  IF pg_relation_filenode('orders'::regclass) <> original THEN
        #|    RAISE EXCEPTION 'DROP COLUMN unexpectedly rewrote the table';
        #|  END IF;
        #|  ALTER TABLE parent DROP CONSTRAINT parent_pkey;
        #|  IF to_regclass('parent_pkey') IS NOT NULL THEN RAISE EXCEPTION 'Owned index survived'; END IF;
        #|  DROP TABLE history CASCADE;
        #|  IF to_regclass('history_view') IS NOT NULL THEN RAISE EXCEPTION 'Dependent view survived'; END IF;
        #|END $$;
      )),
      ("TRUNCATE and owned sequence recovery through savepoint rollback", (
        #|SAVEPOINT before_truncate;
        #|TRUNCATE events RESTART IDENTITY;
        #|DO $$ DECLARE new_id integer; BEGIN
        #|  IF (SELECT count(*) FROM events) <> 0 THEN RAISE EXCEPTION 'Rows survived'; END IF;
        #|  INSERT INTO events DEFAULT VALUES RETURNING id INTO new_id;
        #|  IF new_id <> 1 THEN RAISE EXCEPTION 'Identity did not restart'; END IF;
        #|END $$;
        #|ROLLBACK TO before_truncate;
        #|DO $$ BEGIN
        #|  IF (SELECT count(*) FROM events) <> 2 THEN RAISE EXCEPTION 'Rows not restored'; END IF;
        #|  IF nextval('events_id_seq') <> 3 THEN RAISE EXCEPTION 'Sequence not restored'; END IF;
        #|END $$;
      )),
    ] {
      println("Checking " + name)
      sql("BEGIN; SET LOCAL search_path=moonddl_guard_probe,pg_catalog; SET LOCAL lock_timeout='2s'; SET LOCAL statement_timeout='20s'; " + body + " ROLLBACK;")
    }
    None
  } catch { error => Some("\{Repr(error)}") }
  // Setup succeeded, so this schema belongs to this run. Failed case connections
  // close/rollback before cleanup; pre-existing schemas never reach this branch.
  sql("DROP SCHEMA moonddl_guard_probe CASCADE;")
  if failure is Some(message) { fail(message) }
  println("PostgreSQL 18 semantic checks passed.")
}
