        #|  IF pg_relation_filenode('orders'::regclass)<>original OR (SELECT virtual_doubled FROM orders WHERE id=1)<>20 THEN RAISE EXCEPTION 'Virtual generation unexpectedly rewrote/lost value'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN doubled SET EXPRESSION AS (amount*3);
        #|  IF (SELECT doubled FROM orders WHERE id=1)<>30 THEN RAISE EXCEPTION 'Expression replacement failed'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN doubled DROP EXPRESSION;
        #|  UPDATE orders SET amount=11 WHERE id=1;
        #|  IF (SELECT doubled FROM orders WHERE id=1)<>30 OR (SELECT virtual_doubled FROM orders WHERE id=1)<>22 THEN RAISE EXCEPTION 'Expression removal did not preserve base value'; END IF;
        #|  ALTER TABLE orders ALTER COLUMN sequence_id SET GENERATED BY DEFAULT;
        #|  ALTER TABLE orders ALTER COLUMN sequence_id DROP IDENTITY;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN legacy_sequence bigserial;
        #|  IF pg_relation_filenode('orders'::regclass)=original OR pg_get_serial_sequence('orders','legacy_sequence') IS NULL THEN RAISE EXCEPTION 'Serial rewrite/ownership missing'; END IF;
        #|  original := pg_relation_filenode('orders'::regclass);
        #|  ALTER TABLE orders ADD COLUMN external_id uuid DEFAULT gen_random_uuid();
        #|  IF pg_relation_filenode('orders'::regclass)=original THEN RAISE EXCEPTION 'UUID default did not rewrite'; END IF;
        #|END $$;
      )),
      ("direct uniqueness null semantics and primary-key requirements", (
        #|DO $$ BEGIN
        #|  BEGIN
        #|    ALTER TABLE orders ADD CONSTRAINT legacy_unique UNIQUE (legacy);
        #|    RAISE EXCEPTION 'Duplicate key incorrectly accepted';
        #|  EXCEPTION WHEN unique_violation THEN NULL; END;
        #|END $$;
        #|ALTER TABLE orders ADD CONSTRAINT amount_unique UNIQUE(amount);
        #|DO $$ BEGIN
        #|  IF NOT EXISTS (SELECT 1 FROM pg_locks WHERE pid=pg_backend_pid() AND relation='orders'::regclass AND mode='AccessExclusiveLock' AND granted) THEN RAISE EXCEPTION 'Unique build lock missing'; END IF;
        #|END $$;
        #|INSERT INTO history VALUES (NULL),(NULL),(1);
        #|ALTER TABLE history ADD CONSTRAINT nullable_unique UNIQUE(id);
        #|DO $$ BEGIN
        #|  BEGIN ALTER TABLE history ADD CONSTRAINT nulls_equal UNIQUE NULLS NOT DISTINCT(id); RAISE EXCEPTION 'Duplicate nulls accepted'; EXCEPTION WHEN unique_violation THEN NULL; END;
        #|  BEGIN ALTER TABLE history ADD PRIMARY KEY(id); RAISE EXCEPTION 'Null primary key accepted'; EXCEPTION WHEN not_null_violation THEN NULL; END;
        #|END $$;
        #|DELETE FROM history WHERE id IS NULL;
        #|ALTER TABLE history ADD PRIMARY KEY(id);
      )),
      ("rename identity, retained lock and savepoint restoration", (
        #|SAVEPOINT before_rename;
        #|ALTER TABLE orders RENAME COLUMN legacy TO external_reference;
        #|ALTER TABLE orders RENAME CONSTRAINT orders_pkey TO purchases_pkey;
        #|ALTER TABLE orders RENAME TO purchases;
        #|DO $$ BEGIN
        #|  IF to_regclass('orders') IS NOT NULL OR to_regclass('purchases') IS NULL THEN RAISE EXCEPTION 'Table identity not renamed'; END IF;
