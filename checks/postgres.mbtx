        #|  END;
        #|  IF EXISTS(SELECT 1 FROM pg_attribute WHERE attrelid='orders'::regclass AND attname='rolled_back' AND NOT attisdropped) THEN RAISE EXCEPTION 'Failed statement partially added a column'; END IF;
        #|END $$;
      )),
