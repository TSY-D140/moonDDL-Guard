///|
test "generated column review distinguishes identity serial stored and virtual effects" {
  for
    (tail, operation, diagnostic) in [
      ("n bigint GENERATED ALWAYS AS IDENTITY", "add_identity_column", "PG514"),
      (
        "n int GENERATED BY DEFAULT AS IDENTITY NOT NULL", "add_identity_column",
        "PG514",
      ),
      ("n bigserial", "add_serial_column", "PG514"),
      ("IF NOT EXISTS n serial NOT NULL", "add_serial_column", "PG514"),
      (
        "total int GENERATED ALWAYS AS (amount * 2) STORED", "add_stored_generated_column",
        "PG514",
      ),
      (
        "total int GENERATED ALWAYS AS (amount * 2) VIRTUAL", "add_virtual_generated_column",
        "PG516",
      ),
      (
        "total int GENERATED ALWAYS AS (amount * 2)", "add_virtual_generated_column",
        "PG516",
      ),
    ] {
    let r = @moonddl_guard.review_sql(
      "ALTER TABLE orders ADD COLUMN " + tail,
      transaction=@moonddl_guard.Autocommit,
      delivery=@moonddl_guard.PerStatement,
    )
    assert_true(r.is_complete(), msg=tail)
    assert_eq(r.statements()[0].operation, operation)
    assert_eq(r.findings().filter(f => f.code == diagnostic).length(), 1)
    assert_eq(r.findings().filter(f => f.code == "PG502").length(), 0)
    assert_eq(
      r.to_json(),
      @moonddl_guard.decode_report(r.to_json().stringify()).to_json(),
    )
  }
}

///|
test "altering existing generation does not fabricate old-row identity assignment" {
  for
    (tail, code) in [
      ("ADD GENERATED ALWAYS AS IDENTITY", "PG517"),
      ("SET GENERATED BY DEFAULT", "PG517"),
      ("DROP IDENTITY IF EXISTS", "PG517"),
      ("SET EXPRESSION AS (amount * 3)", "PG518"),
      ("DROP EXPRESSION IF EXISTS", "PG519"),
    ] {
    let r = @moonddl_guard.review_sql(
      "ALTER TABLE orders ALTER COLUMN n " + tail,
      transaction=@moonddl_guard.Autocommit,
      delivery=@moonddl_guard.PerStatement,
    )
    assert_true(r.is_complete(), msg=tail)
    assert_eq(r.findings().filter(f => f.code == code).length(), 1)
    assert_eq(r.findings().filter(f => f.code == "PG514").length(), 0)
  }
  for name in ["gen_random_uuid", "uuidv4", "uuidv7"] {
    let r = @moonddl_guard.review_sql(
      "ALTER TABLE t ADD COLUMN u uuid DEFAULT " + name + "()",
      transaction=@moonddl_guard.Autocommit,
      delivery=@moonddl_guard.PerStatement,
    )
    assert_true(r.is_complete())
    assert_eq(r.findings().filter(f => f.code == "PG503").length(), 1)
  }
}

///|
test "unknown generation expressions options and invalid combinations are retained" {
  for
    tail in [
      "ADD n int GENERATED ALWAYS AS IDENTITY (START WITH 1)", "ADD n text GENERATED ALWAYS AS IDENTITY",
      "ADD n int GENERATED BY DEFAULT AS (a * 2) STORED", "ADD n int GENERATED ALWAYS AS (custom(a)) STORED",
      "ADD n public.custom_type GENERATED ALWAYS AS (a) VIRTUAL", "ADD n int GENERATED ALWAYS AS () STORED",
      "ALTER n SET GENERATED ALWAYS AS IDENTITY", "ALTER n DROP EXPRESSION CASCADE",
      "ALTER n SET EXPRESSION AS (custom(a))",
    ] {
    let sql = "ALTER TABLE t " + tail
    let r = @moonddl_guard.review_sql(
      sql,
      transaction=@moonddl_guard.Autocommit,
      delivery=@moonddl_guard.PerStatement,
    )
    assert_false(r.is_complete(), msg=tail)
    assert_eq(r.statements()[0].sql, sql)
  }
}

///|
test "generation changes compose with transaction rollback baselines and export" {
  let sql = "BEGIN; SAVEPOINT p; ALTER TABLE t ADD n int GENERATED ALWAYS AS (a * 2) STORED; ROLLBACK TO p; UPDATE t SET a=1 WHERE id<10; COMMIT;"
  let r = @moonddl_guard.review_sql(
    sql,
    transaction=@moonddl_guard.Autocommit,
    delivery=@moonddl_guard.PerStatement,
  )
  assert_true(r.is_complete())
  assert_eq(r.findings().filter(f => f.code == "PG803").length(), 0)
  let empty = @moonddl_guard.review_sql(
    "",
    transaction=@moonddl_guard.Autocommit,
    delivery=@moonddl_guard.PerStatement,
  )
  let delta = @moonddl_guard.compare_reviews(empty, r)
  assert_eq(
    delta.to_json(),
    @moonddl_guard.decode_delta(delta.to_json().stringify()).to_json(),
  )
  assert_eq(
    r.to_sarif("migrations/generated.sql"),
    r.to_sarif("migrations/generated.sql"),
  )
}
