///|
priv enum RenameAction {
  RenameTable(String)
  RenameColumn
  RenameConstraint
  RenameIndex
}

///|
priv struct RenameSpec {
  source_key : String
  action : RenameAction
}

///|
fn short_identifier(tokens : Array[@syntax.Token], i : Int32) -> Bool {
  i >= 0 &&
  i < tokens.length() &&
  is_identifier(tokens[i]) &&
  !tokens[i].text.is_empty() &&
  @utf8.encode(tokens[i].text).length() <= 63
}

///|
fn rename_spec(tokens : Array[@syntax.Token]) -> RenameSpec? {
  if tokens.length() > 256 || !word(tokens, 0, "ALTER") {
    return None
  }
  let index = word(tokens, 1, "INDEX")
  if !index && !word(tokens, 1, "TABLE") {
    return None
  }
  let mut start = 2
  if word(tokens, start, "IF") && word(tokens, start + 1, "EXISTS") {
    start += 2
  }
  let only = !index && word(tokens, start, "ONLY")
  if only {
    start += 1
  }
  let mut i = match tracked_relation_end(tokens, start) {
    Some(end) => end
    None => return None
  }
  let source_end = i
  if !word(tokens, i, "RENAME") {
    return None
  }
  i += 1
  let source_key = constraint_table_key(tokens, start, source_end)
  if word(tokens, i, "TO") {
    if only || i + 2 != tokens.length() || !short_identifier(tokens, i + 1) {
      return None
    }
    let action = if index {
      RenameIndex
    } else {
      // Reuse the canonical single-name JSON; the source grammar has at most
      // one schema component, and its encoding is generated by this package.
      let replacement = constraint_table_key(tokens, i + 1, i + 2)
      let destination = if source_end - start == 3 {
        let schema = constraint_table_key(tokens, start, start + 1)
        schema[:schema.length() - 1].to_owned() +
        "," +
        replacement[1:].to_owned()
      } else {
        replacement
      }
      RenameTable(destination)
    }
    return Some({ source_key, action, })
  }
  if index {
    return None
  }
  let constraint = word(tokens, i, "CONSTRAINT")
  if constraint || word(tokens, i, "COLUMN") {
    i += 1
  }
  if !short_identifier(tokens, i) ||
    !word(tokens, i + 1, "TO") ||
    !short_identifier(tokens, i + 2) ||
    i + 3 != tokens.length() {
    return None
  }
  Some({
    source_key,
    action: if constraint {
      RenameConstraint
    } else {
      RenameColumn
    },
  })
}

///|
fn review_rename(
  spec : RenameSpec,
  held : Map[String, HeldTableLock],
  output : Array[Finding],
  part : Segment,
  number : Int32,
) -> String {
  let operation = match spec.action {
    RenameIndex => {
      finding(
        output,
        part,
        number,
        "PG704",
        Warning,
        "Renaming an index takes SHARE UPDATE EXCLUSIVE on the index; its owning table and dependent tooling are unverified.",
        "Inspect index ownership, concurrent index operations and scripts using the old name. This metadata rename does not rebuild the index.",
      )
      "rename_index"
    }
    RenameTable(destination) => {
      held.remove(spec.source_key)
      held[destination] = AccessExclusive
      "rename_table"
    }
    RenameColumn => {
      held[spec.source_key] = AccessExclusive
      "rename_column"
    }
    RenameConstraint => {
      held[spec.source_key] = AccessExclusive
      "rename_constraint"
    }
  }
  if !(spec.action is RenameIndex) {
    finding(
      output,
      part,
      number,
      "PG701",
      Warning,
      "Table, column or constraint rename takes ACCESS EXCLUSIVE until transaction end; a metadata-only change still blocks concurrent access.",
      "Set a lock budget and commit promptly. Table rename transfers the tracked relation lock to its new lexical name; savepoint rollback restores the old mapping.",
    )
  }
  finding(
    output,
    part,
    number,
    "PG702",
    Warning,
    "Renaming can break application SQL, prepared statements, caches and deployment scripts that still use the old name.",
    "Coordinate all readers/writers and rolling releases; consider an expand/backfill/cutover/contract workflow. PostgreSQL dependency updates do not rewrite external application code.",
  )
  finding(
    output,
    part,
    number,
    "PG703",
    Advisory,
    "Object existence, target-name collisions, descendants and dependent index/constraint names have not been inspected.",
    "Verify catalog state and application dependencies; IF EXISTS does not compare definitions. No data rewrite or complete dependency graph is inferred from a rename.",
  )
  operation
}
