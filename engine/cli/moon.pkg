import {
  "TSY-D140/moonddl_guard" @guard,
  "moonbitlang/core/env",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
}

pkgtype(kind: "executable")

options(
  targets: {
    "args_js.mbt": [ "js" ],
    "args_host.mbt": [ "wasm", "wasm-gc", "native" ],
    "exit_wasm.mbt": [ "wasm", "wasm-gc" ],
    "exit_native.mbt": [ "native" ],
  },
)
